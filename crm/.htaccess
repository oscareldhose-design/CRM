# MAP Operating System (CRM): web server rules (Apache / LiteSpeed). Upload this file with the rest.
Options -Indexes
DirectoryIndex index.html

# The lib and data folders are never served to browsers.
RedirectMatch 404 /(lib|data)(/|$)
<FilesMatch "\.(sqlite|db|json|log|md|mjs)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "DENY"
    Header always set X-Robots-Tag "noindex, nofollow"
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-store"
    </FilesMatch>
    # Browsers check for a newer copy of the styles and scripts each time, so an update shows straight away.
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Send visitors to https:// (uncomment once your SSL certificate is working).
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
